# 前端 UI 登录（Vite 构建时注入，勿提交真实密码）
# 复制为 .env.local 后填入值，再执行 npm run dev / npm run build

# 主人密码：侧栏与路由全功能；须与 backend/.env 的 API_WRITE_TOKEN 相同
VITE_UI_OWNER_PASSWORD=

# 访客密码：仅仪表盘 / 当前持仓 / 交易历史（只读）
VITE_UI_GUEST_PASSWORD=

# 开发调试用：设为 true 时跳过登录、等同主人（生产勿用）
# VITE_UI_AUTH_DISABLED=true

# 可选：单独写操作令牌（一般不必填，默认用 owner 密码）
# VITE_API_WRITE_TOKEN=
