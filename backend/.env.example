DATABASE_URL=sqlite+aiosqlite:///data/trading_bot.db
ENCRYPTION_KEY=
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true
CORS_ORIGINS=http://8.211.153.248:8000

# HTTP Proxy for accessing Binance mainnet (required in China)
# Format: http://host:port or http://user:pass@host:port
# Examples:
#   HTTP_PROXY=http://127.0.0.1:7890
#   HTTP_PROXY=http://user:password@proxy.example.com:8080
HTTP_PROXY=

# 写操作鉴权（必填！与 frontend/.env.local 的 VITE_API_WRITE_TOKEN 相同）
# 未设置时 POST/PUT/DELETE /api/* 对公网完全开放，会被脚本批量刷账户
API_WRITE_TOKEN=
